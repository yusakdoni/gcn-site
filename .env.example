# Salin isi file ini ke Vercel Project Settings > Environment Variables.
# Jangan commit file .env yang berisi key asli ke git.

# Wajib — form Contact & RFQ email notification.
RESEND_API_KEY=

# Opsional tetapi direkomendasikan — Gemini free tier untuk AI Sales Assistant.
# Tanpa key ini chatbot tetap bekerja memakai zero-cost fallback.
GEMINI_API_KEY=
GEMINI_MODEL=

# Website → GCN ERP secure lead bridge.
# URL production backend GCN Management System.
GCN_ERP_API_URL=https://api-mis.gcnusantara.com
# HARUS sama persis dengan WEBSITE_LEAD_TOKEN pada project Vercel gcn-erp-backend.
# Gunakan random secret minimal 32 karakter. Jangan gunakan NEXT_PUBLIC_ prefix.
GCN_WEBSITE_LEAD_TOKEN=

# SEO production.
NEXT_PUBLIC_SITE_INDEXABLE=true
