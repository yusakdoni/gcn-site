# Salin isi file ini ke Vercel Project Settings > Environment Variables.
# Jangan commit file .env yang berisi key asli ke git.

# Wajib — untuk form Contact & RFQ benar-benar mengirim email.
# Daftar gratis di https://resend.com, verifikasi domain gcnusantara.com,
# lalu generate API key di dashboard Resend.
RESEND_API_KEY=

# Wajib — untuk AI Sales Agent (chat widget) bisa menjawab.
# Ambil dari https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opsional — set ke "false" HANYA di deployment staging/preview supaya
# search engine tidak mengindeks-nya sebagai duplikat domain utama.
# Biarkan kosong/true di production.
NEXT_PUBLIC_SITE_INDEXABLE=true
